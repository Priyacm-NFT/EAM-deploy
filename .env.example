# ClamAV
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# Auth (generate RS256 keypair for dev)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
MFA_ENCRYPTION_KEY=00000000000000000000000000000000

# Integration config encryption
INTEGRATION_SECRET_KEY=00000000000000000000000000000000

# SMTP (dev: Mailhog)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false

# API
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
